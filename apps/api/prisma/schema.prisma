generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  NOT_APPLIED
  APPLIED
}

model Application {
  id          String   @id @default(cuid())
  company     String
  role        String?
  jobUrl      String?
  // The posting's own job/req ID (e.g. Workday's "JR355248"), extracted from
  // the URL at parse time — used for dedup since the same posting is often
  // reached via different tracking-parameter-laden URLs (utm_*, source=,
  // etc.), so jobUrl alone isn't a reliable duplicate key.
  jobId       String?
  jdText      String?
  postedDate  DateTime?
  applyByDate DateTime?
  salaryRange String?
  experienceLevel String?

  status              ApplicationStatus @default(NOT_APPLIED)
  appliedDate         DateTime?
  lastMessageReceivedDate DateTime?
  rejectedDate        DateTime?

  // Structured resume content (StructuredResume shape — see shared-types) as
  // of the resume-template rework; older rows may still hold the pre-rework
  // markdown string and are not migrated (see resume-template feature notes).
  resumeContent    Json?
  resumeGeneratedAt DateTime?

  // Interview progress, entered by hand once applied (status values: see shared-types).
  interviewRounds Int?
  interviewStatus String?

  // Who referred the user for this application (set when marking it applied).
  referredByContactId String?
  referredByContact   CompanyContact? @relation("ApplicationReferrer", fields: [referredByContactId], references: [id], onDelete: SetNull)
  // The resume the user actually submitted with (uploaded when marking applied).
  appliedResume ApplicationAppliedResume?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([company])
  @@index([status])
  @@index([jobId])
  @@index([referredByContactId])
}

model ApplicationAppliedResume {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  filename      String
  mimeType      String
  data          Bytes
  uploadedAt    DateTime    @default(now())
}

enum CompanyDiscoveryStatus {
  PENDING
  DISCOVERING
  DONE
  FAILED
}

// A company the user wants to watch for open roles — entered in bulk on the
// Company Resumes page, then its career page is scraped for DiscoveredRoles.
model TrackedCompany {
  id             String   @id @default(cuid())
  name           String   @unique
  careerPageUrl  String?
  discoveryStatus   CompanyDiscoveryStatus @default(PENDING)
  discoveryError    String?
  lastDiscoveredAt  DateTime?
  // How trustworthy the last successful scan's coverage is: HIGH | MEDIUM | LOW,
  // plus a one-line reason (see scanConfidence in company-roles.service.ts).
  lastScanConfidence     String?
  lastScanConfidenceNote String?

  roles    DiscoveredRole[]
  contacts CompanyContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One open role found on a tracked company's career page. Stays unselected
// (candidate pool) until the user pushes it to Applications, at which point
// applicationId is set and it shows on the right/selected side of the split
// Applications tab instead of the left/unselected side.
model DiscoveredRole {
  id        String @id @default(cuid())
  companyId String
  company   TrackedCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title      String
  roleUrl    String
  jobId      String?
  postedDate DateTime?
  jdText     String?

  atsScore           Int?
  atsScoreComputedAt DateTime?

  // Location signal extracted from the JD at scoring time — used to filter/flag
  // roles against the candidate's location + remote preferences (see
  // ResumePromptTemplate.locationCountry/State/City/openToRemote). isRemote
  // null means the JD's location couldn't be determined yet (not scored, or
  // scoring couldn't find a location signal in the text).
  roleIsRemote    Boolean?
  roleCountry     String?
  roleState       String?
  roleCity        String?
  locationMismatch Boolean?

  // Minimum years of experience the JD requires, extracted at scoring time
  // (e.g. "5+ years" -> 5, "3-5 years" -> 3 — the low end, since that's the
  // real qualifying bar). Null means not yet scored, or the JD stated no
  // numeric experience requirement at all (not the same as 0).
  roleMinYearsExperience Int?
  experienceMismatch     Boolean?

  applicationId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, roleUrl])
  @@index([companyId])
  @@index([applicationId])
}

// A freeform "Stories" document (work-history narrative, resume, etc.) the
// user uploads and pins to exactly one structured background entry at
// upload time — entryType+entryId says which. There is no separate
// confirmation/extraction step at upload: resume generation reads this
// file's raw text live, per entry, when a resume including that entry is
// actually generated (see ExtractedNarrative for the resulting cache).
model StoryFile {
  id         String         @id @default(cuid())
  filename   String
  storedPath String
  mimeType   String
  entryType  StoryEntryType
  entryId    String
  createdAt  DateTime       @default(now())

  @@index([entryType, entryId])
}

model ResumeFile {
  id         String         @id @default(cuid())
  filename   String
  storedPath String
  mimeType   String
  entryType  StoryEntryType
  entryId    String
  createdAt  DateTime       @default(now())

  @@index([entryType, entryId])
}

model ResumePromptTemplate {
  id   String @id @default(cuid())
  name String @default("default")

  // Fixed template body (the generic 7-step process, editable but ships with a default)
  templateBody String

  // Profile fields — personal facts substituted into the template at generation time
  // Candidate's own full name — printed top-center on the generated resume PDF.
  candidateName         String?
  // Contact details printed in the resume header line beneath the candidate
  // name (email | city, state | phone | LinkedIn) — see structured-resume-pdf.ts.
  candidateEmail        String?
  candidatePhone        String?
  linkedinUrl           String?
  // Shown on the resume's contact line after LinkedIn: GitHub as its URL, the
  // portfolio as the text "Portfolio" hyperlinked to this URL.
  githubUrl             String?
  portfolioUrl          String?
  targetRoleArchetype   String?
  disqualifierKeywords  String[] @default([])
  // Candidate's location, used to limit/flag scanning to matching roles.
  // City is optional and never used alone — only country+state are checked
  // against a role's location (see DiscoveredRole.locationMismatch).
  locationCountry       String?
  locationState         String?
  locationCity          String?
  // When true, a role whose JD says it allows remote work is treated as a
  // location match if the JD's stated remote-eligible geography covers the
  // candidate's country/state, even if the role's base office doesn't.
  openToRemote          Boolean  @default(false)
  maxYearsExperience    Int?
  matchScoreTarget      Int      @default(93)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Structured background entries the candidate curates once on /resumes. Each is
// flagged required (always included) or optional (agent includes only when
// relevant to the specific JD being tailored for — see prompt instructions).
// All four share the same start/end shape: startMonth/startYear mark when it
// began, isPresent means it's ongoing (endMonth/endYear are then ignored),
// otherwise endMonth/endYear mark when it ended.
model WorkExperienceEntry {
  id               String   @id @default(cuid())
  company          String
  title            String?
  location         String?
  startMonth       Int?
  startYear        Int?
  endMonth         Int?
  endYear          Int?
  isPresent        Boolean  @default(false)
  isFamilyBusiness Boolean  @default(false)
  required         Boolean  @default(true)
  sortOrder        Int      @default(0)
  // Bullet count bounds for this specific entry's resume bullets — null
  // means open-ended (no instruction given to the model for that bound).
  minBullets       Int?
  maxBullets       Int?
  // When true, the resu agent is allowed to change this entry's job title
  // on the generated resume if it would better fit the target role — off
  // by default, since silently retitling a real job is something the user
  // must explicitly opt into per entry, not a blanket resume-wide behavior.
  allowRetitle     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model EducationEntry {
  id         String   @id @default(cuid())
  school     String
  degree     String?
  field      String?
  location   String?
  startMonth Int?
  startYear  Int?
  endMonth   Int?
  endYear    Int?
  isPresent  Boolean  @default(false)
  required   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model InternshipEntry {
  id               String   @id @default(cuid())
  company          String
  title            String?
  location         String?
  startMonth       Int?
  startYear        Int?
  endMonth         Int?
  endYear          Int?
  isPresent        Boolean  @default(false)
  isClassProject   Boolean  @default(false)
  isFamilyBusiness Boolean  @default(false)
  required         Boolean  @default(false)
  sortOrder        Int      @default(0)
  // Bullet count bounds for this specific entry's resume bullets — null
  // means open-ended (no instruction given to the model for that bound).
  minBullets       Int?
  maxBullets       Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProjectEntry {
  id         String   @id @default(cuid())
  name       String
  repoUrl    String?
  // Whether repoUrl points to a public GitHub repo — resolved once via an
  // unauthenticated GitHub API call whenever repoUrl is set/changed (see
  // EntriesService.resolveRepoVisibility), not re-checked at resume
  // generation time, since visibility essentially never changes once a
  // repo is connected and a live check on every generation would just add
  // latency for no benefit. Null means not yet resolved or repoUrl is empty.
  isRepoPublic Boolean?
  liveUrl    String?
  // Distinct from liveUrl (the deployed product itself) — a demo video/GIF/
  // recording/sandbox link, when the live product isn't public or a quick
  // demo is more useful to a reviewer than the real thing.
  demoUrl    String?
  location   String?
  startMonth Int?
  startYear  Int?
  endMonth   Int?
  endYear    Int?
  isPresent  Boolean  @default(false)
  required   Boolean  @default(false)
  sortOrder  Int      @default(0)
  // Bullet count bounds for this specific entry's resume bullets — null
  // means open-ended (no instruction given to the model for that bound).
  minBullets Int?
  maxBullets Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Published/preprint papers, patents, or similar academic-style credits —
// a separate background section from Projects since authorship/venue/date
// matter more than a tech stack or a live demo here.
model PaperEntry {
  id             String   @id @default(cuid())
  title          String
  venue          String?
  // "Jane Doe, John Smith, ..." — kept as one field rather than a list since
  // author order/formatting conventions vary a lot by field/venue.
  authors        String?
  url            String?
  publishedMonth Int?
  publishedYear  Int?
  required       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Formatting rules for rendering a structured resume to PDF/preview. Every
// numeric field is a MIN/MAX range, not a fixed value — the renderer picks
// the largest values that still fit the content on one page, shrinking
// toward each field's min before ever truncating content. Constraints that
// tie fields together (name font vs. bullet font, header font vs. section
// font, "always bold") are enforced in the renderer, not stored here twice.
model ResumeTemplate {
  id   String @id @default(cuid())
  name String @default("default")

  // Stored in inches (not points) — resolvedFields() in
  // structured-resume-pdf.ts converts to points, pdfkit's native unit,
  // before use. 0.5in == 36pt, 0.75in == 54pt (the prior point-based
  // defaults), kept equal here so existing saved templates render
  // unchanged after the inches migration backfills these from the old
  // point columns.
  marginTopMin    Float @default(0.5)
  marginTopMax    Float @default(0.75)
  marginBottomMin Float @default(0.5)
  marginBottomMax Float @default(0.75)
  marginLeftMin   Float @default(0.5)
  marginLeftMax   Float @default(0.75)
  marginRightMin  Float @default(0.5)
  marginRightMax  Float @default(0.75)

  // Bullet text font size — the base every other font-size rule is relative
  // to. Hard floor of 9pt enforced in the renderer regardless of what's
  // stored here (a lower min would silently violate the "never below 9pt"
  // rule the user has to be able to trust).
  bulletFontMin Float @default(9)
  bulletFontMax Float @default(11)

  // Entry name (company/school/project title) font size, expressed as an
  // offset ABOVE the bullet font actually used that render, not an absolute
  // size — e.g. nameFontOffsetMin=1 means "at least 1pt larger than
  // whatever bullet size this render landed on." Always bold (not a toggle).
  nameFontOffsetMin Float @default(1)
  nameFontOffsetMax Float @default(4)

  // Section header (e.g. "Work Experience") font size offset ABOVE the name
  // font used that render — 0 means "same size as name font" is allowed,
  // per the "same or up to 1pt larger" spec. Always bold.
  sectionHeaderFontOffsetMin Float @default(0)
  sectionHeaderFontOffsetMax Float @default(1)

  // Absolute size (pt) of the section headers — WORK EXPERIENCE, PROJECTS &
  // INTERNSHIPS, SKILLS & ACTIVITIES, EDUCATION. This is what the renderer uses;
  // the offset columns above are kept only so older rows/migrations stay valid.
  sectionHeaderFontMin Float @default(9)
  sectionHeaderFontMax Float @default(12)

  // Gap (pt) above and below each ENTRY header line (the "COMPANY | Title" row
  // under a section header), separate from the section-header spacing.
  spacingBeforeEntryHeaderMin Float @default(0.5)
  spacingBeforeEntryHeaderMax Float @default(1.5)
  spacingAfterEntryHeaderMin  Float @default(1)
  spacingAfterEntryHeaderMax  Float @default(2)

  horizontalTabStop Float @default(36)

  spacingBeforeSectionMin  Float @default(6)
  spacingBeforeSectionMax  Float @default(14)
  spacingAfterSectionMin   Float @default(2)
  spacingAfterSectionMax   Float @default(6)
  spacingBetweenBulletsMin Float @default(1)
  spacingBetweenBulletsMax Float @default(4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSettings {
  id                  String @id @default(cuid())
  inactivityThresholdDays Int @default(14)
  deadlineThresholdDays   Int @default(30)

  // Open Roles filters — persisted so they survive a page reload. Null
  // means "off" for minMatchScoreFilter (no numeric default makes sense);
  // postedBeforeTodayFilterOn defaults to false since a brand-new user's
  // roles shouldn't vanish before they've had a chance to see them.
  minMatchScoreFilter       Int?
  postedBeforeTodayFilterOn Boolean @default(false)
  // Cutoff for postedBeforeTodayFilterOn, in days back from today — 0 means
  // "before today" (the original behavior), N means "before N days ago",
  // keeping roles posted in the last N days.
  postedWithinDaysFilter    Int     @default(0)
  // Hides Open Roles whose locationMismatch/experienceMismatch is true, or
  // whose JD matches a disqualifierKeywords entry — a "Conditions not
  // valid" role, not a real numeric match.
  hideInvalidConditionRolesFilterOn Boolean @default(false)
  // Comma-separated keywords (case-insensitive) — an Open Role is hidden if
  // its TITLE contains any of them (JD text deliberately excluded: broad
  // words like "Engineer" are common filler in JD prose and would
  // false-positive on unrelated roles). Separate from the profile's
  // disqualifierKeywords (which marks a role "Conditions not valid" but
  // still shows it); this one removes the role from Open Roles entirely.
  excludeKeywordsFilter String @default("")
  // Comma-separated free text; an open role must mention at least one of the
  // terms in its title or location (empty = no location text filter).
  locationTextFilter    String @default("")

  // Daily LLM spend cap in USD — the agent (agent/cost_guard.py) refuses new
  // requests once today's llm_calls total reaches it. Editable on /llm-usage.
  llmDailyBudgetUsd Float @default(5)

  updatedAt DateTime @updatedAt
}

// One row per individual LLM request, posted by the agent's CostGuardModel.
model LlmCall {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  agent          String
  // Groups the calls of one agent run (cost_guard.run_scope); null on rows
  // recorded before this column existed.
  runId          String?
  model          String
  inputTokens    Int
  cachedTokens   Int
  outputTokens   Int
  inputCostUsd   Float
  outputCostUsd  Float
  costUsd        Float

  @@index([createdAt])
  @@index([runId])
}

// Per-1M-token USD prices by model/deployment name — input, cached input and
// output are priced separately. A model with no row here is costed at $0.
model LlmModelPrice {
  model             String @id
  inputPer1M        Float
  cachedInputPer1M  Float
  outputPer1M       Float
}

// Single-user GitHub OAuth connection — the resu agent reads connected repos'
// README/metadata live, per entry, when a resume including that project is
// generated (see ExtractedNarrative for the resulting cache).
model GithubConnection {
  id           String   @id @default(cuid())
  githubLogin  String
  accessToken  String
  scope        String?
  connectedAt  DateTime @default(now())
}

model ConnectedRepo {
  id        String         @id @default(cuid())
  fullName  String         @unique // "owner/repo"
  // Pinned to exactly one entry (almost always a ProjectEntry) at connect
  // time — required, same as StoryFile/ResumeFile's entryType/entryId.
  entryType StoryEntryType
  entryId   String
  addedAt   DateTime       @default(now())

  @@index([entryType, entryId])
}

enum GenerationSessionStatus {
  RUNNING
  WAITING_FOR_INPUT
  DONE
  ACCEPTED
  ERROR
}

enum GenerationSessionScope {
  APPLICATION
  LINKEDIN
  COMPANY
  ENTRY_DOCUMENT
  REFERRAL
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
}

// One chat-style generation run. Tracks live status for the right-pane UI
// (orange = running/waiting, green = done, none = accepted) and holds the full
// conversation so a multi-turn run (agent asks a clarifying question, user
// answers, agent continues) can be resumed via PydanticAI's message_history.
// scope determines which of applicationId/company/entryType+entryId (if any) is set:
// APPLICATION    -> applicationId required, company/entryType/entryId null
// LINKEDIN       -> all null (whole-candidate scope)
// COMPANY        -> company required, applicationId/entryType/entryId null
// ENTRY_DOCUMENT -> entryType+entryId required, applicationId/company null
// REFERRAL       -> contactId + referralTone + referralRoleIds required, company = the
//                   contact's company name (label only); runs unattended and saves a
//                   ReferralRequest itself on completion (no Accept step)
model GenerationSession {
  id            String                  @id @default(cuid())
  scope         GenerationSessionScope  @default(APPLICATION)
  applicationId String?
  company       String?
  entryType     StoryEntryType?
  entryId       String?
  contactId       String?
  referralTone    String?
  referralChannel String?
  referralRoleIds String[]                @default([])
  status        GenerationSessionStatus @default(RUNNING)
  errorMessage  String?
  // Opaque PydanticAI message-history JSON blob (from AgentRunResult.all_messages(),
  // round-tripped via TypeAdapter) — needed to resume the same reasoning thread
  // on the next turn. Not rendered; SessionMessage below is the UI-facing log.
  messageHistoryJson String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  messages SessionMessage[]

  @@index([applicationId])
  @@index([company])
  @@index([entryType, entryId])
  @@index([scope])
  @@index([createdAt])
}

model SessionMessage {
  id        String            @id @default(cuid())
  sessionId String
  session   GenerationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  createdAt DateTime          @default(now())

  @@index([sessionId])
}

// Current accepted LinkedIn draft — a singleton (one candidate, one profile).
// Updated whenever a LINKEDIN-scope GenerationSession is accepted; read
// directly by the /linkedin tab rather than re-parsing session history.
model LinkedinProfile {
  id           String   @id @default(cuid())
  headline     String?
  about        String?
  // Array of { entryType, entryId, bullets: string[] } — see LinkedinEntryBullets
  // in agent/linkedin/agent.py for the exact shape.
  entryBullets Json     @default("[]")
  updatedAt    DateTime @updatedAt
}

// Current accepted common resume per company, generated only from that
// company's own applications. Upserted whenever a COMPANY-scope
// GenerationSession is accepted.
model CompanyResume {
  id            String   @id @default(cuid())
  company       String   @unique
  // See Application.resumeContent — same StructuredResume shape/migration note.
  resumeContent Json
  updatedAt     DateTime @updatedAt
}

enum StoryEntryType {
  WORK_EXPERIENCE
  EDUCATION
  INTERNSHIP
  PROJECT
  PAPER
}

// One generated-and-editable detailed document per entry — the sole content
// source fed into resume/LinkedIn/company-resume generation. Replaces
// ExtractedNarrative (per-source, invisible, cache-only) with one
// user-visible, user-editable artifact per entry. Content is Tiptap's
// native HTML output, sanitized on write — stored and round-tripped as-is,
// fed to/from the LLM as plain HTML, no separate structured representation.
model EntryDocument {
  id        String         @id @default(cuid())
  entryType StoryEntryType
  entryId   String

  contentHtml String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entryType, entryId])
}

// LinkedIn does not offer an API for a user's own connections/messages to
// third-party apps (deliberately restricted since ~2018) — this is manually
// imported from LinkedIn's own data-export ZIP (Settings > Get a copy of
// your data), not a live OAuth connection. One row per import batch so
// re-imports don't silently merge/dedupe against stale data.
model LinkedinImport {
  id          String   @id @default(cuid())
  importedAt  DateTime @default(now())
  connections LinkedinConnection[]
  messages    LinkedinMessageThread[]
}

model LinkedinConnection {
  id           String         @id @default(cuid())
  importId     String
  import       LinkedinImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  firstName    String?
  lastName     String?
  url          String?
  emailAddress String?
  company      String?
  position     String?
  connectedOn  DateTime?

  @@index([importId])
}

model LinkedinMessageThread {
  id          String         @id @default(cuid())
  importId    String
  import      LinkedinImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  // LinkedIn's messages.csv is one row per message, not per thread; grouped
  // here by CONVERSATION ID from that export so a thread's messages stay
  // together without re-deriving grouping logic on every read.
  conversationId String
  fromName       String?
  toName         String?
  content        String?
  sentAt         DateTime?

  @@index([importId])
  @@index([conversationId])
}

// Someone the user knows at a tracked company, who can be asked for a referral.
model CompanyContact {
  id          String         @id @default(cuid())
  companyId   String
  company     TrackedCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  linkedinUrl String?
  email       String?
  phone       String?

  referrals ReferralRequest[]
  referredApplications Application[] @relation("ApplicationReferrer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// One generated referral ask for a contact: the message, the single resume
// written to cover every selected role, and how that resume scored against each
// role's JD. targetMet=false means the 90% ATS target wasn't reachable for at
// least one JD (note says which and why).
model ReferralRequest {
  id            String         @id @default(cuid())
  contactId     String
  contact       CompanyContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // The REFERRAL chat session that produced it (a session can produce several:
  // the first run, then a final draft per uploaded resume). Null on old rows.
  sessionId     String?
  tone          String
  // linkedin | whatsapp | text | email — what the message was written for.
  channel       String?
  // [{ id, title, url }] of the roles the message links to.
  roles         Json
  message       String
  resumeContent Json
  // [{ roleId, title, score, missing: string[] }]
  scores        Json
  targetMet     Boolean
  note          String?

  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([sessionId])
}
