generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  NOT_APPLIED
  APPLIED
}

model Application {
  id          String   @id @default(cuid())
  company     String
  role        String?
  jobUrl      String?
  jdText      String?
  postedDate  DateTime?
  applyByDate DateTime?
  salaryRange String?
  experienceLevel String?

  status              ApplicationStatus @default(NOT_APPLIED)
  appliedDate         DateTime?
  lastMessageReceivedDate DateTime?
  rejectedDate        DateTime?

  resumeContent    String?
  resumeGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([company])
  @@index([status])
}

model StoryFile {
  id         String   @id @default(cuid())
  filename   String
  storedPath String
  mimeType   String
  createdAt  DateTime @default(now())
}

model ResumeFile {
  id         String   @id @default(cuid())
  filename   String
  storedPath String
  mimeType   String
  createdAt  DateTime @default(now())
}

model ResumePromptTemplate {
  id   String @id @default(cuid())
  name String @default("default")

  // Fixed template body (the generic 7-step process, editable but ships with a default)
  templateBody String

  // Profile fields — personal facts substituted into the template at generation time
  targetRoleArchetype   String?
  disqualifierKeywords  String[] @default([])
  locationZip           String?
  maxYearsExperience    Int?
  matchScoreTarget      Int      @default(93)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Structured background entries the candidate curates once on /resumes. Each is
// flagged required (always included) or optional (agent includes only when
// relevant to the specific JD being tailored for — see prompt instructions).
model WorkExperienceEntry {
  id        String   @id @default(cuid())
  company   String
  title     String?
  yearIn    Int?
  yearOut   Int? // null = present/ongoing
  required  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model EducationEntry {
  id        String   @id @default(cuid())
  school    String
  degree    String?
  year      Int?
  required  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model InternshipEntry {
  id        String   @id @default(cuid())
  company   String
  year      Int?
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ProjectEntry {
  id        String   @id @default(cuid())
  name      String
  repoUrl   String?
  liveUrl   String?
  year      Int?
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model AppSettings {
  id                  String @id @default(cuid())
  inactivityThresholdDays Int @default(14)
  deadlineThresholdDays   Int @default(30)

  updatedAt DateTime @updatedAt
}

// Single-user GitHub OAuth connection — the resu agent reads connected repos'
// READMEs as additional "Stories" material for resume generation.
model GithubConnection {
  id           String   @id @default(cuid())
  githubLogin  String
  accessToken  String
  scope        String?
  connectedAt  DateTime @default(now())
}

model ConnectedRepo {
  id        String   @id @default(cuid())
  fullName  String   @unique // "owner/repo"
  addedAt   DateTime @default(now())
}
