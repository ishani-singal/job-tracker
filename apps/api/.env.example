DATABASE_URL="postgresql://<user>:<password>@localhost:5433/jobtracker"
PORT=4100

# Same Azure OpenAI provider/key Soma uses — shared across job-link parsing and the
# resume-generation agent so there's nothing separate to manage when this ports into Soma.
AZURE_LLM_API_KEY=
AZURE_LLM_API_VERSION=2024-12-01-preview
AZURE_LLM_DEPLOYMENT_NAME=gpt-5.1
AZURE_LLM_ENDPOINT=

# GitHub OAuth App (register at https://github.com/settings/developers) — used to
# read connected repos' READMEs as extra resume source material.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://<your-host>:4100/auth/github/callback
WEB_APP_URL=http://<your-host>:3100
