generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  NOT_APPLIED
  APPLIED
}

model Application {
  id          String   @id @default(cuid())
  company     String
  role        String?
  jobUrl      String?
  jdText      String?
  postedDate  DateTime?
  applyByDate DateTime?
  salaryRange String?
  experienceLevel String?

  status              ApplicationStatus @default(NOT_APPLIED)
  appliedDate         DateTime?
  lastMessageReceivedDate DateTime?
  rejectedDate        DateTime?

  resumeContent    String?
  resumeGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([company])
  @@index([status])
}

model StoryFile {
  id         String   @id @default(cuid())
  filename   String
  storedPath String
  mimeType   String
  createdAt  DateTime @default(now())
}

model ResumeFile {
  id         String   @id @default(cuid())
  filename   String
  storedPath String
  mimeType   String
  createdAt  DateTime @default(now())
}

model ResumePromptTemplate {
  id   String @id @default(cuid())
  name String @default("default")

  // Fixed template body (the generic 7-step process, editable but ships with a default)
  templateBody String

  // Profile fields — personal facts substituted into the template at generation time
  targetRoleArchetype   String?
  disqualifierKeywords  String[] @default([])
  locationZip           String?
  maxYearsExperience    Int?
  matchScoreTarget      Int      @default(93)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Structured background entries the candidate curates once on /resumes. Each is
// flagged required (always included) or optional (agent includes only when
// relevant to the specific JD being tailored for — see prompt instructions).
// All four share the same start/end shape: startMonth/startYear mark when it
// began, isPresent means it's ongoing (endMonth/endYear are then ignored),
// otherwise endMonth/endYear mark when it ended.
model WorkExperienceEntry {
  id               String   @id @default(cuid())
  company          String
  title            String?
  location         String?
  startMonth       Int?
  startYear        Int?
  endMonth         Int?
  endYear          Int?
  isPresent        Boolean  @default(false)
  isFamilyBusiness Boolean  @default(false)
  required         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
}

model EducationEntry {
  id         String   @id @default(cuid())
  school     String
  degree     String?
  field      String?
  location   String?
  startMonth Int?
  startYear  Int?
  endMonth   Int?
  endYear    Int?
  isPresent  Boolean  @default(false)
  required   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model InternshipEntry {
  id               String   @id @default(cuid())
  company          String
  title            String?
  location         String?
  startMonth       Int?
  startYear        Int?
  endMonth         Int?
  endYear          Int?
  isPresent        Boolean  @default(false)
  isClassProject   Boolean  @default(false)
  isFamilyBusiness Boolean  @default(false)
  required         Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
}

model ProjectEntry {
  id         String   @id @default(cuid())
  name       String
  repoUrl    String?
  liveUrl    String?
  location   String?
  startMonth Int?
  startYear  Int?
  endMonth   Int?
  endYear    Int?
  isPresent  Boolean  @default(false)
  required   Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model AppSettings {
  id                  String @id @default(cuid())
  inactivityThresholdDays Int @default(14)
  deadlineThresholdDays   Int @default(30)

  updatedAt DateTime @updatedAt
}

// Single-user GitHub OAuth connection — the resu agent reads connected repos'
// READMEs as additional "Stories" material for resume generation.
model GithubConnection {
  id           String   @id @default(cuid())
  githubLogin  String
  accessToken  String
  scope        String?
  connectedAt  DateTime @default(now())
}

model ConnectedRepo {
  id        String   @id @default(cuid())
  fullName  String   @unique // "owner/repo"
  addedAt   DateTime @default(now())
}

enum GenerationSessionStatus {
  RUNNING
  WAITING_FOR_INPUT
  DONE
  ACCEPTED
  ERROR
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
}

// One chat-style generation run for a given application. Tracks live status for
// the right-pane UI (orange = running/waiting, green = done, none = accepted)
// and holds the full conversation so a multi-turn run (agent asks a clarifying
// question, user answers, agent continues) can be resumed via PydanticAI's
// message_history.
model GenerationSession {
  id            String                  @id @default(cuid())
  applicationId String
  status        GenerationSessionStatus @default(RUNNING)
  errorMessage  String?
  // Opaque PydanticAI message-history JSON blob (from AgentRunResult.all_messages(),
  // round-tripped via TypeAdapter) — needed to resume the same reasoning thread
  // on the next turn. Not rendered; SessionMessage below is the UI-facing log.
  messageHistoryJson String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  messages SessionMessage[]

  @@index([applicationId])
  @@index([createdAt])
}

model SessionMessage {
  id        String            @id @default(cuid())
  sessionId String
  session   GenerationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  createdAt DateTime          @default(now())

  @@index([sessionId])
}
